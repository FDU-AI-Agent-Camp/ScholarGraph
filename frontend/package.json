{
  "name": "scholargraph-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run knip",
    "check:ci": "npm run check && npm run test && npm run build",
    "generate:api-types": "openapi-typescript ../docs/api/openapi.yaml -o src/api/generated/schema.d.ts",
    "demo:setup": "cd .. && uv run python scripts/run_frontend_demo.py"
  },
  "dependencies": {
    "@antv/g6": "^5.0.49",
    "@element-plus/icons-vue": "^2.3.1",
    "@microsoft/fetch-event-source": "^2.0.1",
    "axios": "^1.9.0",
    "element-plus": "^2.9.11",
    "pinia": "^3.0.2",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.2.0",
    "happy-dom": "^20.9.0",
    "knip": "^6.14.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.10"
  },
  "overrides": {
    "js-yaml": "^4.1.2"
  }
}
