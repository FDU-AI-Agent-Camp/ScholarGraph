# ScholarGraph Demo Profile 覆盖层
# 使用：export APP_PROFILE=demo（Linux/macOS）或 $env:APP_PROFILE='demo'（PowerShell）
# pydantic-settings 会按顺序加载 .env → .env.demo，后者覆盖前者。

APP_PROFILE=demo
APP_ENV=staging
LLM_MODE=live

# claim_evolution 演示必须走 TD-4 两阶段漏斗（粗筛 + Cross-Encoder 精排）
RERANKER_ENABLED=true
RERANKER_MODEL=bge-reranker-large

# 演示建议同时开启 Patrol 语义通路
ENABLE_PATROL_SEMANTIC_PATH=true
PATROL_SEMANTIC_THRESHOLD=0.88
EMBEDDING_MODEL=bge-m3

# 可选：关闭启动握手探针（网络未就绪时临时跳过 Fail-Fast）
# STARTUP_RERANKER_PROBE=false

# 必填：在 .env 中填写 SCHOLARGRAPH_API_KEY / EMBEDDING_API_KEY / RERANKER_API_KEY
