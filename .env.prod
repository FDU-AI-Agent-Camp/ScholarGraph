# ScholarGraph Production Profile 覆盖层
# 使用：export APP_PROFILE=prod（Linux/macOS）或 $env:APP_PROFILE='prod'（PowerShell）
# pydantic-settings 会按顺序加载 .env → .env.prod，后者覆盖前者。

APP_PROFILE=prod
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LLM_MODE=live

# 生产环境硬性要求：Reranker 必须开启且指定模型
RERANKER_ENABLED=true
# MaaS 重排序：控制台可用名为 bge-reranker-v2-m3（勿用 bge-reranker-large → 404 Invalid model）
RERANKER_MODEL=bge-reranker-v2-m3
# 重排序 API 在 /v1（不是 LLM chat 常用的 /v2）；勿留空以免回落到 LLM_API_BASE_URL=/v2 后 404
RERANKER_API_BASE_URL=https://api.modelarts-maas.com/v1

ENABLE_PATROL_SEMANTIC_PATH=true
PATROL_SEMANTIC_THRESHOLD=0.88
EMBEDDING_MODEL=bge-m3
# Embedding 同样走 /v1；勿回落到 LLM 的 /v2
EMBEDDING_API_BASE_URL=https://api.modelarts-maas.com/v1

# 生产默认启用启动握手探针；网络维护窗口可临时设为 false
# STARTUP_RERANKER_PROBE=false

# 必填：在 .env 中填写 SCHOLARGRAPH_API_KEY / EMBEDDING_API_KEY / RERANKER_API_KEY
