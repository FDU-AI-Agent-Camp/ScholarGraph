# ScholarGraph 环境变量模板
# 使用：复制为 .env 后填写真实值（.env 已被 gitignore，勿提交）

# ── 应用 ────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── API 服务（FastAPI / Agent 入口）────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── 大模型（华为云 ModelArts MaaS · OpenAI 兼容 /v2）────────
# LLM_MODE：mock = 本地模板（默认，无需 Key）；live = 真实 MaaS 推理
LLM_MODE=mock
# live 模式下必填（控制台 API Key）；mock 模式可留空
SCHOLARGRAPH_API_KEY=
# live 模式必填：ModelArts MaaS 网关根路径（勿带末尾 /chat/completions）
LLM_API_BASE_URL=https://api.modelarts-maas.com/v2
# 主模型（高质量）/ 备用模型（低延迟）；live 模式生效
# 默认值与 backend/config.py 一致；接 ModelArts MaaS 时请按控制台可用模型名填写
LLM_MODEL_PRIMARY=DeepSeek-V3-64K
LLM_MODEL_FALLBACK=Qwen3-32B-64K
# 兼容旧配置：若仅设置 LLM_MODEL，等效于 LLM_MODEL_PRIMARY
# LLM_MODEL=DeepSeek-V3-64K
LLM_TIMEOUT_SECONDS=120

# OpenAI 或兼容网关（可选，与上一组二选一或并存）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# ── 数据库 ──────────────────────────────────────────────
# SQLite（默认，路径相对于仓库根目录）
DATABASE_URL=sqlite:///./data/scholargraph.db
# MySQL 示例（需 uv sync --extra mysql）：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/scholargraph

# ── 图谱与语料路径 ─────────────────────────────────────
GRAPH_DATA_DIR=./data/graphs
UPLOAD_DIR=./uploads

# ── CORS（Vue 3 + Vite 开发服）──────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Ingest 双路路由（§2.1）──────────────────────────────
# auto：≤25 页 MinerU 异步 + PyMuPDF；>25 页 GROBID 异步 + PyMuPDF
INGEST_ROUTE=auto
INGEST_SHORT_PAGE_LIMIT=25
INGEST_MINERU_ENABLED=true
INGEST_MINERU_LANG=auto
INGEST_MINERU_MODEL_SOURCE=modelscope
INGEST_MINERU_TIMEOUT_SECONDS=600
# 短 PDF path B 依赖 MinerU CLI：仓库根目录执行 uv sync --extra mineru

# ── GROBID（长 PDF 异步 path B）────────────────────────
GROBID_URL=http://127.0.0.1:8070
GROBID_TIMEOUT_SECONDS=300
GROBID_FALLBACK_PYMUPDF=true

# ── LLM head merge（复用 SCHOLARGRAPH_API_KEY）──────────
INGEST_HEAD_LLM_ENABLED=false
INGEST_HEAD_LLM_MODEL=
INGEST_HEAD_LLM_TIMEOUT_SECONDS=60

# ── 图谱抽取（Phase F）──────────────────────────────────
EXTRACT_LLM_ENABLED=true
EXTRACT_MAX_INPUT_CHARS=20000
EXTRACT_HEURISTIC_FALLBACK=true

# ── 前端（frontend/.env.development，非本文件）──────────
# 推荐留空 VITE_API_BASE_URL，走 Vite /api 代理；直连时设为 http://localhost:8000
# VITE_USE_MOCK=false
