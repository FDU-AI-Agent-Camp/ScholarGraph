# ScholarGraph 环境变量模板
# 使用：复制为 .env 后填写真实值（.env 已被 gitignore，勿提交）

# ── 应用 ────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── API 服务（FastAPI / Agent 入口）────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── 大模型（主密钥：GraphScholar / 平台 API）────────────
# 代码中优先读取 SCHOLARGRAPH_API_KEY；也可配置 OpenAI 兼容端点
SCHOLARGRAPH_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=120

# OpenAI 或兼容网关（可选，与上一组二选一或并存）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# ── 数据库 ──────────────────────────────────────────────
# SQLite（默认，路径相对于仓库根目录）
DATABASE_URL=sqlite:///./data/scholargraph.db
# MySQL 示例（需 uv sync --extra mysql）：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/scholargraph

# ── 图谱与语料路径 ─────────────────────────────────────
GRAPH_DATA_DIR=./data/graphs
UPLOAD_DIR=./uploads

# ── CORS（Vue 3 + Vite 开发服）──────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 前端（frontend/.env.development，非本文件）──────────
# VITE_API_BASE_URL=http://localhost:8000
