# ScholarGraph 环境变量模板
# 使用：复制为 .env 后填写真实值（.env 已被 gitignore，勿提交）

# ── 应用 ────────────────────────────────────────────────
# APP_PROFILE：ci = 轻量化单测/本地开发；demo = 验收演示；prod = 生产部署
# 未设置 APP_PROFILE 时应用启动将 Fail-Fast 阻断（见 backend/startup/profile_validation.py）
APP_PROFILE=ci
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── API 服务（FastAPI / Agent 入口）────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── 大模型（华为云 ModelArts MaaS · OpenAI 兼容 /v2）────────
# LLM_MODE：mock = 本地模板（默认，无需 Key）；live = 真实 MaaS 推理
LLM_MODE=mock
# live 模式下必填（控制台 API Key）；mock 模式可留空
SCHOLARGRAPH_API_KEY=
# live 模式必填：ModelArts MaaS 网关根路径（勿带末尾 /chat/completions）
LLM_API_BASE_URL=https://api.modelarts-maas.com/v2
# 主模型（高质量）/ 备用模型（低延迟）；live 模式生效
# 默认值与 backend/config.py 一致；接 ModelArts MaaS 时请按控制台可用模型名填写
LLM_MODEL_PRIMARY=deepseek-v4-pro
LLM_MODEL_FALLBACK=deepseek-v4-flash
# 兼容旧配置：若仅设置 LLM_MODEL，等效于 LLM_MODEL_PRIMARY
# LLM_MODEL=DeepSeek-V3-64K
LLM_TIMEOUT_SECONDS=120

# ── QA Generator / Judge 双模型非对称架构（Phase 4 评估）────────
# Generator：SSE 答题流（低延迟、长上下文）；留空则复用 LLM_MODEL_PRIMARY
LLM_MODEL_QA=
QA_API_KEY=
QA_API_BASE_URL=
QA_TIMEOUT_SECONDS=0
# Judge：Structured Outputs 评测（强推理）；留空则复用 LLM_MODEL_PRIMARY
LLM_MODEL_JUDGE=
# 兼容旧配置名
# JUDGE_MODEL=kimi-k2.6
JUDGE_API_KEY=
JUDGE_API_BASE_URL=
JUDGE_TIMEOUT_SECONDS=120

# OpenAI 或兼容网关（可选，与上一组二选一或并存）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# ── 数据库 ──────────────────────────────────────────────
# SQLite（默认，路径相对于仓库根目录）
DATABASE_URL=sqlite:///./data/scholargraph.db
# MySQL 示例（需 uv sync --extra mysql）：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/scholargraph
# true：启动时若 DB 为空则加载 docs/api/fixtures 中的 4 篇 demo 论文
SEED_DEMO_PAPERS=false

# ── 图谱与语料路径 ─────────────────────────────────────
GRAPH_DATA_DIR=./data/graphs
UPLOAD_DIR=./uploads

# ── CORS（Vue 3 + Vite 开发服）──────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Ingest 双路路由（§2.1）──────────────────────────────
# auto：≤25 页 MinerU 异步 + PyMuPDF；>25 页 GROBID 异步 + PyMuPDF
INGEST_ROUTE=auto
INGEST_SHORT_PAGE_LIMIT=25
INGEST_MINERU_ENABLED=true
INGEST_MINERU_LANG=auto
INGEST_MINERU_MODEL_SOURCE=modelscope
INGEST_MINERU_TIMEOUT_SECONDS=600
# 可选：外部 MinerU API 地址。新版 MinerU CLI 默认会启动本地 API server；
# 在中文路径等环境下可能加载模型失败，可在外部（如 WSL/Docker）启动 mineru-api 后填写此处。
# 示例：MINERU_API_URL=http://127.0.0.1:8001
MINERU_API_URL=
# 短 PDF path B 依赖 MinerU CLI：仓库根目录执行 uv sync --extra mineru

# ── GROBID（长 PDF 异步 path B）────────────────────────
GROBID_URL=http://127.0.0.1:8070
GROBID_TIMEOUT_SECONDS=300
GROBID_FALLBACK_PYMUPDF=true

# ── LLM head merge（复用 SCHOLARGRAPH_API_KEY）──────────
INGEST_HEAD_LLM_ENABLED=false
INGEST_HEAD_LLM_MODEL=
INGEST_HEAD_LLM_TIMEOUT_SECONDS=60

# ── 图谱抽取（Phase F）──────────────────────────────────
EXTRACT_LLM_ENABLED=true
EXTRACT_MAX_INPUT_CHARS=20000
EXTRACT_HEURISTIC_FALLBACK=true
# 长论文分块抽取（超过 EXTRACT_MAX_INPUT_CHARS 时启用）
EXTRACT_CHUNKED_ENABLED=true
EXTRACT_CHUNK_MAX_CHARS=12000
EXTRACT_CHUNK_CONCURRENCY=2
EXTRACT_CHUNK_MAX_CHUNKS=10
# 抽取对 transient 错误（超时/限流/网络/5xx）自动 tenacity 指数退避重试 3 次（2~30s）。
# 抽取 schema 大、耗时长于分类；主模型失败时会再试备用模型（最坏 ≈ 2× LLM_TIMEOUT_SECONDS）
# 若频繁 fallback，查后端日志 extract_llm attempt failed / extract_llm_fallback（含 reason、warning_codes、elapsed_ms）
# 质量门控：低于阈值时状态为 ready_with_warnings 并打上 low_confidence_graph
EXTRACT_MIN_SUPPORTS_RATIONALE_COVERAGE=0.5
EXTRACT_MAX_ISOLATED_NODE_RATIO=0.4

# ── 范式分类（Phase G）──────────────────────────────────
CLASSIFIER_LLM_ENABLED=true              # live 下 false → 直接启发式 + classify_warnings
CLASSIFIER_HEURISTIC_FALLBACK=true       # false → LLM 失败不降级，流水线可 failed
# 两阶段分类器（理解 → 判定）。true：先让 LLM 抽 profile，再做范式判定；false：单阶段直接判定
CLASSIFIER_TWO_PHASE_ENABLED=true
# 核心贡献追问法。true：在 profile 之后、最终判定之前增加核心贡献追问（Stage B.1）
CLASSIFIER_CORE_CONTRIBUTION_ENABLED=true
# 阶段 A 专用模型；留空表示复用主模型（LLM_MODEL_PRIMARY）
CLASSIFIER_PROFILE_LLM_MODEL=
# 阶段 A 超时（秒）。profile 输出短、token 低，通常 60s 足够
CLASSIFIER_PROFILE_LLM_TIMEOUT_SECONDS=60

# ── 二阶语义聚类（Slice 2 图谱脱水）──────────────────────
# 是否启用语义聚类 / 孤岛缝合；默认 false，避免 mock / 测试环境意外调用 Embedding
SEMANTIC_CLUSTERING_ENABLED=false
# 节点余弦相似度 >= 该值时合并为同一节点（0~1）
# 留空或删除则使用模型内置默认值：
#   bge-m3: 0.85
#   text-embedding-3-small: 0.65
#   其他: 0.80
# SEMANTIC_SIMILARITY_THRESHOLD=0.85

# 小孤岛与最大主分量连线的最低相似度（0~1）
# 留空或删除则使用模型内置默认值：
#   bge-m3: 0.75
#   text-embedding-3-small: 0.55
#   其他: 0.70
# SEMANTIC_KNN_THRESHOLD=0.75

# 云端 Reranker（精细化语义合并 + claim_evolution RQ 漏斗精排）
# 用于：① 图谱语义聚类二次校验；② claim_evolution 双阶段 RQ 漏斗阶段 2（Cross-Encoder）
# ⚠ 默认 false 时 claim_evolution 不走粗筛 0.42 + 精排，而回退严格双塔（中文 0.75 / 英文 0.55），
# 演示 / 生产模板（RERANKER 硬性开启）见仓库根目录 .env.demo / .env.prod；
# 启动演示后端前必须：export APP_PROFILE=demo（或 PowerShell: $env:APP_PROFILE='demo'）
RERANKER_ENABLED=false
# 云端 reranker 模型名；华为云 MaaS 请用控制台可用名，当前实测：bge-reranker-v2-m3
# （bge-reranker-large 会返回 404 Invalid model，勿用作默认）
RERANKER_MODEL=
# OpenAI 兼容基地址；华为云 MaaS Reranker / Embedding 为 https://api.modelarts-maas.com/v1
# （LLM chat 常用 /v2，二者不同；不要带 /rerank 后缀，SDK 会自动拼接）
# 留空则复用 LLM_API_BASE_URL —— 若 LLM 配的是 /v2，Reranker 务必在此显式写 /v1
RERANKER_API_BASE_URL=
# 单独指定 Reranker Key；留空则复用 SCHOLARGRAPH_API_KEY
RERANKER_API_KEY=
# 单批候选对最大数量（控制 payload 大小与并发成本）
RERANKER_BATCH_SIZE=32
# Reranker 分数 >= 该值才视为真正同质节点对并进入并查集合并（0~1）
RERANKER_THRESHOLD=0.85

# ── Patrol 巡检配置 ─────────────────────────────────────────
# method_overlap 语义软通路（默认开启；关闭后仅字面标签匹配）
# ENABLE_PATROL_SEMANTIC_PATH=true
# Method 双塔初筛余弦阈值（默认 0.88）
# PATROL_SEMANTIC_THRESHOLD=0.88
# 语义相似度矩阵 M*N 上限，超出则降级为字面匹配（默认 500）
# PATROL_MAX_MATRIX_SIZE=500
# 拓扑 RQ 语义共振阈值：按候选 RQ 对判定，非 claim_evolution 漏斗
# PATROL_TOPOLOGY_RQ_SEMANTIC_THRESHOLD=0.75
# PATROL_TOPOLOGY_RQ_SEMANTIC_THRESHOLD_ENGLISH=0.55

# claim_evolution 双阶段 RQ 漏斗
# 阶段 1：双塔 embedding 粗筛（默认 0.42）
# PATROL_CLAIM_RQ_COARSE_THRESHOLD=0.42
# 阶段 2：Cross-Encoder 精排硬卡点（默认 0.60；需 RERANKER_ENABLED=true）
# PATROL_RERANK_THRESHOLD=0.60
# 精排候选对上限（默认 8）
# PATROL_CLAIM_RQ_MAX_RERANK_CANDIDATES=8
# Reranker 关闭时的严格双塔回退阈值（与粗筛 0.42 行为不同，生产建议保持 RERANKER_ENABLED=true）
# PATROL_CLAIM_RQ_THRESHOLD=0.75
# PATROL_CLAIM_RQ_THRESHOLD_ENGLISH=0.55
# Claim VectorStore 补全 top-k（默认 3）
# PATROL_CLAIM_CHUNK_TOP_K=3

# Embedding 提供方：openai = OpenAI 兼容端点（含华为云 MaaS）；ollama = 本地 Ollama
EMBEDDING_PROVIDER=openai
# Embedding 模型名；华为云 MaaS 请填写控制台实际模型名，例如 bge-m3 / bge-large-zh
EMBEDDING_MODEL=bge-m3
# OpenAI 兼容基地址；华为云 MaaS Embedding 为 https://api.modelarts-maas.com/v1
# （注意：不要带 /embeddings 后缀，SDK 会自动拼接）
# 留空则复用 LLM_API_BASE_URL
EMBEDDING_API_BASE_URL=
# 单独指定 Embedding Key；留空则复用 SCHOLARGRAPH_API_KEY
EMBEDDING_API_KEY=
# Ollama 地址（仅当 EMBEDDING_PROVIDER=ollama 时生效）
EMBEDDING_OLLAMA_URL=http://localhost:11434
# 单次向 OpenAI/Ollama 派发向量化请求的最大 Chunk 数量
EMBEDDING_BATCH_SIZE=32

# ── V2 RAG 向量索引（ChromaDB）───────────────────────────
CHROMADB_PATH=./data/chroma
CHROMADB_CHUNK_COLLECTION=paper_chunks
CHROMADB_ENTITY_COLLECTION=paper_entities
CHROMADB_RELATION_COLLECTION=paper_relations
RAG_CHUNK_SIZE_CHARS=1500
RAG_CHUNK_OVERLAP_RATIO=0.20
RAG_TOP_K_CHUNKS=5
RAG_TOP_K_ENTITIES=5
RAG_TOP_K_RELATIONS=5

# P13 dual-layer RAG indexing watchdog + orphan-run generation guard
# Layer-1: asyncio.wait_for around a single paper index build (handlers.py)
RAG_SINGLE_INDEX_TIMEOUT_SECONDS=120
# Layer-2: dedicated OS-thread macro sweep using sync SQLAlchemy
# (scan_and_promote_stuck_indexing_sync — not run_async onto the FastAPI loop)
RAG_INDEXING_WATCHDOG_SECONDS=300
RAG_INDEXING_WATCHDOG_INTERVAL_SECONDS=60
RAG_INDEXING_WATCHDOG_ENABLED=true
# Heartbeat: handler pulses while indexing; watchdog only promotes when
# indexing_started_at is old AND indexing_heartbeat is missing/stale
RAG_INDEXING_HEARTBEAT_INTERVAL_SECONDS=15
RAG_INDEXING_HEARTBEAT_STALE_SECONDS=90
# Processing / pending orphan heal
# cold-boot: status∈{pending,processing} AND updated_at < boot − PROCESS_ORPHAN_GRACE_SECONDS → PROCESS_ORPHANED
# wall-clock: processing > PROCESS_WATCHDOG_SECONDS → PROCESS_TIMEOUT; pending > PENDING_QUEUE_TIMEOUT_SECONDS → QUEUE_TIMEOUT
PROCESS_WATCHDOG_ENABLED=true
PROCESS_WATCHDOG_SECONDS=900
PROCESS_WATCHDOG_INTERVAL_SECONDS=60
PROCESS_ORPHAN_GRACE_SECONDS=10
PENDING_QUEUE_TIMEOUT_SECONDS=3600
# Dev/CI loop block detector: -1=auto (100ms in development/test, off in prod); 0=off
ASYNCIO_SLOW_CALLBACK_MS=-1

# ── 前端（frontend/.env.development，非本文件）──────────
# 推荐留空 VITE_API_BASE_URL，走 Vite /api 代理；直连时设为 http://localhost:8000
# VITE_USE_MOCK=false
